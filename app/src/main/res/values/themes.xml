<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Premium Dark theme: near-black background, blue accent, white text. -->
    <style name="Theme.TunIptv" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_accent</item>
        <item name="colorPrimaryDark">@color/background_dark</item>
        <item name="colorAccent">@color/blue_accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <!-- Fullscreen player theme (phone). -->
    <style name="Theme.TunIptv.Player" parent="Theme.TunIptv">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
